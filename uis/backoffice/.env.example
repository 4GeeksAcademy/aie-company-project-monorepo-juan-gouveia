# Variables de entorno necesarias, sin valores reales. Copia este archivo como .env.local.
# URL base de la API del tracker.
NEXT_PUBLIC_API_BASE_URL=
# URL base de la API de Brasaland (services/brasaland-api). Es una variable de servidor, sin
# NEXT_PUBLIC_: solo la usa el intermediario app/api/[...path]/route.ts y nunca llega al navegador.
API_BASE_URL=http://localhost:8000/api/v1
# Telemetría: URL del receptor al que el navegador envía los lotes de eventos (hoy, el stub de la API).
# La usa el navegador directamente, así que es pública (NEXT_PUBLIC_) y debe ser accesible desde él.
# Sin ella, la telemetría queda desactivada. Se fija al compilar: tras cambiarla, reinicia next dev.
NEXT_PUBLIC_TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events
# Entorno de los eventos: development, staging o production (por defecto, development).
NEXT_PUBLIC_TELEMETRY_ENVIRONMENT=development
