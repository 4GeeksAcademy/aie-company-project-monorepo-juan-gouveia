# Variables de entorno necesarias, sin valores reales. Copia este archivo como .env.local.
# URL base de la API del tracker.
NEXT_PUBLIC_API_BASE_URL=
# URL base de la API de Brasaland (services/brasaland-api). Es una variable de servidor, sin
# NEXT_PUBLIC_: solo la usa el intermediario app/api/[...path]/route.ts y nunca llega al navegador.
API_BASE_URL=http://localhost:8000/api/v1
