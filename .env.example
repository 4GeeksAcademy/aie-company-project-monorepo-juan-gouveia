# Variables del stack Docker (`docker compose up` desde la raíz).
# Copia este archivo como .env y rellena los secretos. El .env no se versiona (.gitignore).
# docker-compose.yml solo las referencia con ${VARIABLE}: ningún valor real vive en el YAML ni en
# los Dockerfile. Cada servicio recibe únicamente las variables que necesita.

# --- api (services/brasaland-api) ---------------------------------------------------------------

# Clave de firma de los JWT (mínimo 32 caracteres). Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Minutos de validez del token de acceso.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Cadena de conexión PostgreSQL de Supabase (Session pooler). Es un secreto. Sin ella, la API no arranca.
DATABASE_URL=

# API key de Resend con permiso "Sending access". Es un secreto. Sin ella, la API arranca pero no envía correos.
RESEND_API_KEY=

# Dirección del backoffice que ve el navegador, para el enlace de restablecimiento de contraseña.
FRONTEND_URL=http://localhost:3001

# --- uis (uis/website + uis/backoffice) ---------------------------------------------------------

# URL de la API de Brasaland para el intermediario (BFF) del backoffice. La llamada va de servidor a
# servidor dentro de la red Docker, así que usa el nombre del servicio `api`, no localhost.
API_BASE_URL=http://api:8000/api/v1

# URL base de la API del tracker (/talento). La usa el navegador: debe ser una URL pública.
NEXT_PUBLIC_API_BASE_URL=

# --- Recarga en caliente ------------------------------------------------------------------------

# Los bind mounts desde Windows y macOS no propagan los eventos de archivos al contenedor, así que
# los dos servicios vigilan los cambios por sondeo.
# Next.js 16 (Turbopack): intervalo en milisegundos, leído por watchOptions.pollIntervalMs de cada
# next.config.ts. Turbopack no usa WATCHPACK_POLLING (esa variable solo la lee webpack).
NEXT_WATCH_POLL_INTERVAL_MS=1000
# Uvicorn (watchfiles).
WATCHFILES_FORCE_POLLING=true
