# Variables del stack Docker (`docker compose up` desde la raíz).
# Copia este archivo como .env y rellena los secretos. El .env no se versiona (.gitignore).
# docker-compose.yml solo las referencia con ${VARIABLE}: ningún valor real vive en el YAML ni en
# los Dockerfile. Cada servicio recibe únicamente las variables que necesita.

# --- api (services/brasaland-api) ---------------------------------------------------------------

# Clave de firma de los JWT (mínimo 32 caracteres). Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Minutos de validez del token de acceso.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Cadena de conexión PostgreSQL de Supabase (Session pooler). Es un secreto. Sin ella, la API no arranca.
DATABASE_URL=

# API key de Resend con permiso "Sending access". Es un secreto. Sin ella, la API arranca pero no envía correos.
RESEND_API_KEY=

# Dirección del backoffice que ve el navegador, para el enlace de restablecimiento de contraseña.
FRONTEND_URL=http://localhost:3001

# URL del receptor de telemetría (stub POST /telemetry/events). La API solo la valida y la registra al
# arrancar; el navegador usa NEXT_PUBLIC_TELEMETRY_ENDPOINT. Opcional.
TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events

# Opcionales: sin valor, la API usa su remitente de pruebas de Resend y 30 minutos de validez del enlace.
# EMAIL_FROM=Brasaland <onboarding@resend.dev>
# PASSWORD_RESET_EXPIRE_MINUTES=30

# --- uis (uis/website + uis/backoffice) ---------------------------------------------------------

# URL de la API de Brasaland para el intermediario (BFF) del backoffice. La llamada va de servidor a
# servidor dentro de la red Docker, así que usa el nombre del servicio `api`, no localhost.
API_BASE_URL=http://api:8000/api/v1

# URL base de la API del tracker (/talento). La usa el navegador: debe ser una URL pública.
NEXT_PUBLIC_API_BASE_URL=

# Receptor de telemetría del backoffice. La usa el navegador (no el contenedor), así que va con
# localhost y el puerto publicado de la API, no con el nombre del servicio `api`.
NEXT_PUBLIC_TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events
NEXT_PUBLIC_TELEMETRY_ENVIRONMENT=development

# --- reporting-pipeline y nightly-scheduler -----------------------------------------------------

# No leen este archivo: sus cadenas de conexión son las de roles propios de Supabase y van en el .env de
# cada proyecto, como en local:
#   reporting-pipeline -> data/pipelines/.env (REPORTING_DATABASE_URL; plantilla data/pipelines/.env.example)
#   nightly-scheduler  -> services/jobs/.env (JOBS_DATABASE_URL; plantilla services/jobs/.env.example)
#                         y data/pipelines/.env, para el pipeline que lanza
# Sin esos archivos, los servicios arrancan, pero sus ejecuciones fallan con un mensaje que lo explica.

# --- redis, celery-worker y flower (cola de tareas, #DEV-55) ------------------------------------

# Tampoco leen este archivo. REDIS_URL no hace falta aquí: docker-compose.yml la fija para api,
# celery-worker y flower (redis://redis:6379/0, por el nombre del servicio).
#   celery-worker -> services/tasks/.env (TASKS_DATABASE_URL, la cadena del rol task_worker, y
#                    TASKS_FAULT_INJECTION opcional; plantilla services/tasks/.env.example)
# Sin ese archivo, el worker arranca, pero cada tarea falla con un mensaje que pide TASKS_DATABASE_URL.
# Flower: http://localhost:5555.

# --- Recarga en caliente ------------------------------------------------------------------------

# Los bind mounts desde Windows y macOS no propagan los eventos de archivos al contenedor, así que
# los dos servicios vigilan los cambios por sondeo.
# Next.js: intervalo en milisegundos, leído por watchOptions.pollIntervalMs de cada next.config.ts.
# En Docker, las interfaces corren con webpack (uis/start.sh), porque Turbopack no detecta los cambios
# en los bind mounts.
NEXT_WATCH_POLL_INTERVAL_MS=1000
# Uvicorn (watchfiles).
WATCHFILES_FORCE_POLLING=true
