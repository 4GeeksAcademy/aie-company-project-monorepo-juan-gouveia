# Copia este archivo como .env (no se versiona) para ejecutar scripts/nightly_export.py.
# El pipeline que lanza el script lee su propia conexión de data/pipelines/.env (REPORTING_DATABASE_URL).

# --- Conexión del script (ops.job_runs y la lectura de telemetry_events) -------------------------

# Cadena del rol nightly_jobs de la migración 006 (no la de postgres): Supabase → Connect →
# "Session pooler", con el usuario nightly_jobs.<ref> y su contraseña:
# postgresql://nightly_jobs.<ref>:<contraseña>@<host>.pooler.supabase.com:5432/postgres
# Es un secreto: va solo en .env.
JOBS_DATABASE_URL=

# --- Opcionales -------------------------------------------------------------------------------------

# Día (UTC) que procesa la ejecución, YYYY-MM-DD. Sin ella, ayer en UTC. Debe ser un día ya terminado.
# TARGET_DATE=2026-11-24

# Minutos tras los que una ejecución abierta se considera abandonada (proceso muerto sin cerrar su fila).
# NIGHTLY_STALE_MINUTES=120

# Tiempo máximo del pipeline, en minutos. Debe ser menor que NIGHTLY_STALE_MINUTES.
# NIGHTLY_PIPELINE_TIMEOUT_MINUTES=90

# Entorno de los eventos que lee el pipeline (--environment). Sin ella, el de su configuración (production).
# NIGHTLY_PIPELINE_ENVIRONMENT=development

# Servidor de Prefect del pipeline. Sin ella, cada ejecución arranca uno temporal.
# PREFECT_API_URL=http://localhost:4200/api
