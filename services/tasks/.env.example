# Copia este archivo como .env (no se versiona) para arrancar el worker o Flower fuera de Docker:
#   uv run --env-file .env celery -A brasaland_tasks.celery_app worker -Q default,dead_letter --loglevel=INFO --pool=solo
# (--pool=solo solo en Windows). Dentro de Docker, docker-compose.yml fija REDIS_URL por su cuenta.

# --- Cola de tareas -------------------------------------------------------------------------------

# Redis, broker y backend de resultados: el servicio redis de docker-compose.yml, publicado en el host.
# La misma URL que usa la API. Con 127.0.0.1 y no localhost: en Windows, localhost prueba antes IPv6 y
# cada conexión tarda unos 2 s más (Redis solo está publicado en IPv4).
REDIS_URL=redis://127.0.0.1:6379/0

# --- Base de datos del worker ---------------------------------------------------------------------

# Cadena del rol task_worker de la migración 007 (no la de postgres): Supabase → Connect →
# "Session pooler", con el usuario task_worker.<ref> y su contraseña:
# postgresql://task_worker.<ref>:<contraseña>@aws-<n>-<región>.pooler.supabase.com:5432/postgres
# (el mismo servidor que JOBS_DATABASE_URL). Lee telemetry_events y escribe la DLQ
# (ops.task_dead_letters). Es un secreto: va solo en .env. La API no la usa.
TASKS_DATABASE_URL=

# --- Demo de fallos (opcional) ----------------------------------------------------------------------

# Hace fallar telemetry.report antes de tocar la base (decisión T12). Vacía o ausente: sin fallos.
#   transient    → 4 intentos (10, 20 y 40 s de espera) → DLQ max_retries_exceeded
#   transient:N  → fallan los N primeros intentos y el siguiente termina bien
#   permanent    → sin reintento → DLQ non_retryable
# Se lee al arrancar el worker: para cambiarla, reinícialo. Nunca en producción.
# TASKS_FAULT_INJECTION=transient:2
