# Copia este archivo como .env y rellena los valores. El .env no se versiona.
# Arranque: uv run --env-file .env uvicorn app.main:app --port 8000

# Clave de firma de los JWT (mínimo 32 caracteres). Genera una con:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Minutos de validez del token de acceso.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Opcional: ruta del archivo TinyDB de usuarios y perfiles (por defecto, storage/auth-db.json).
# AUTH_DB_PATH=
