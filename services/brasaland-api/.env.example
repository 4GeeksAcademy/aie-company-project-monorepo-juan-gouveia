# Copia este archivo como .env y rellena los valores. El .env no se versiona.
# Arranque: uv run --env-file .env uvicorn app.main:app --port 8000

# Clave de firma de los JWT (mínimo 32 caracteres). Genera una con:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Minutos de validez del token de acceso.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Opcional: ruta del archivo TinyDB de usuarios y perfiles (por defecto, storage/auth-db.json).
# AUTH_DB_PATH=

# --- Restablecimiento de contraseña y correo (AUTH-03) ---------------------------------------

# Minutos de validez del enlace de restablecimiento: entre 15 y 60 (por defecto, 30).
# PASSWORD_RESET_EXPIRE_MINUTES=30

# API key de Resend (https://resend.com/api-keys), con permiso "Sending access". Es un secreto:
# va solo en .env, nunca en el código. Sin ella, la API arranca pero no envía correos.
RESEND_API_KEY=

# Remitente. Sin dominio verificado en Resend hay que usar onboarding@resend.dev, que solo entrega
# al email de la cuenta de Resend (por defecto: Brasaland <onboarding@resend.dev>).
# EMAIL_FROM=Brasaland <onboarding@resend.dev>

# Dirección del backoffice, para el enlace <FRONTEND_URL>/reset-password?token=... (por defecto, http://localhost:3001).
# FRONTEND_URL=http://localhost:3001
