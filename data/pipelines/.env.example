# Copia este archivo como .env (no se versiona) para ejecutar pipeline.py como script.

# --- Conexión del pipeline (Reporte Semanal de Costo y Merma por Local) ------------------------

# Cadena del rol reporting_pipeline de la migración 005 (no la de postgres): Supabase → Connect →
# "Session pooler", con el usuario reporting_pipeline.<ref> y su contraseña:
# postgresql://reporting_pipeline.<ref>:<contraseña>@<host>.pooler.supabase.com:5432/postgres
# Es un secreto: va solo en .env o en el bloque Secret de Prefect "brasaland-reporting-db"
# (python pipeline.py --register-blocks lo registra desde aquí). Si el bloque existe, se usa el bloque.
REPORTING_DATABASE_URL=

# --- Prefect (opcional) ---------------------------------------------------------------------------

# Sin esta variable, cada corrida usa un servidor temporal de Prefect. Con ella, las corridas y los
# bloques quedan en ese servidor; es obligatoria para `python pipeline.py --serve`.
# PREFECT_API_URL=http://localhost:4200/api
